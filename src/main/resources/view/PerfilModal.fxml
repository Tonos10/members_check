<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox fx:id="profile_modal_layout" alignment="CENTER" spacing="18.0" prefWidth="350.0" prefHeight="420.0" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.PerfilModalController" 
      style="-fx-background-color: linear-gradient(to bottom right, rgba(255,255,255,0.85), rgba(255,255,255,0.3)); -fx-border-color: rgba(255,255,255,0.6); -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 30, 0, 0, 10); -fx-background-radius: 18px; -fx-border-radius: 18px;"
      stylesheets="/css/dashboard.css">
    
    <padding>
        <Insets top="35.0" right="35.0" bottom="35.0" left="35.0"/>
    </padding>

    <Label text="Ajustes de Perfil" styleClass="page-title" style="-fx-font-size: 24px; -fx-text-fill: #263238;" />

    <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="280.0">
        <Label text="Nuevo Username:" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
        <TextField fx:id="txt_new_username" promptText="Ingresa nuevo usuario" styleClass="input-field" prefWidth="280.0" />
    </VBox>

    <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="280.0">
        <Label text="Nueva Password:" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
        <PasswordField fx:id="pwd_new_password" promptText="Nueva contraseña" styleClass="input-field" prefWidth="280.0"/>
    </VBox>

    <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="280.0">
        <Label text="Confirmar Password:" style="-fx-font-weight: bold; -fx-text-fill: #546E7A;"/>
        <PasswordField fx:id="pwd_confirm_password" promptText="Repetir contraseña" styleClass="input-field" prefWidth="280.0"/>
    </VBox>

    <HBox spacing="10.0" alignment="CENTER" prefWidth="280.0" style="-fx-padding: 15 0 0 0;">
        <Button text="Cancelar" onAction="#handle_cancel_profile" prefWidth="135.0" style="-fx-background-color: #ECEFF1; -fx-text-fill: #546E7A; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10px; -fx-cursor: hand;"/>
        <Button fx:id="btn_save_profile" text="Guardar" onAction="#handle_save_profile" styleClass="btn-primary" prefWidth="135.0"/>
    </HBox>
</VBox>